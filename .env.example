# ============================================================
# AI NewsMania — Frontend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Firebase Configuration ---
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- Google OAuth (for Google Sign-In button) ---
VITE_GOOGLE_AUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Google Places API (used in trip planner feature) ---
VITE_GOOGLE_PLACE_API_KEY=your_google_places_api_key

# --- Gemini AI API Key ---
# Used for AI summaries, sentiment analysis, perspectives, and chat
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GOOGLE_GEMINI_AI_API_KEY=your_gemini_api_key_here

# --- News APIs ---
# NewsAPI (https://newsapi.org) — used in development/localhost
VITE_NEWS_API_KEY=your_newsapi_key_here

# WorldNewsAPI (https://worldnewsapi.com) — used in production (avoids CORS)
VITE_WORLD_NEWS_API_KEY=your_worldnewsapi_key_here

# --- OpenAI API Key (optional — for OpenAI-based features) ---
VITE_OPENAI_API_KEY=your_openai_api_key_here
