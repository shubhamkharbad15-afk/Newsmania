# ============================================================
# AI NewsMania — Backend (server/) Environment Variables
# Copy this file to server/.env and fill in your actual values.
# NEVER commit the server/.env file to version control.
# ============================================================

# --- MongoDB Connection ---
MONGODB_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/newsmania?retryWrites=true&w=majority

# --- JWT Secret ---
# Use a long, random string — e.g. generated with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# --- Redis (for rate limiting / article view counts) ---
REDIS_URL=redis://localhost:6379

# --- Server Port ---
PORT=5000
